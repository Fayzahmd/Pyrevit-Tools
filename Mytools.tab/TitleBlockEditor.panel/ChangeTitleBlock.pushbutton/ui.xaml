<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sheet Title Block Manager"
    Height="640" Width="900"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0  scope + search bar -->
            <RowDefinition Height="Auto"/>   <!-- 1  info line          -->
            <RowDefinition Height="*"/>      <!-- 2  the grid           -->
            <RowDefinition Height="Auto"/>   <!-- 3  status + buttons    -->
        </Grid.RowDefinitions>

        <!-- ================= Scope + search ================= -->
        <Border Grid.Row="0" Background="#EEF3FA" BorderBrush="#C7D6EA" BorderThickness="1"
                CornerRadius="3" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Show:" VerticalAlignment="Center" FontWeight="Bold"
                           Margin="0,0,8,0"/>
                <RadioButton x:Name="scope_selected_rb" Content="Selected sheets only"
                             GroupName="scope" VerticalAlignment="Center"
                             Margin="0,0,14,0" Checked="scope_changed"/>
                <RadioButton x:Name="scope_all_rb" Content="All sheets in project"
                             GroupName="scope" VerticalAlignment="Center"
                             Margin="0,0,24,0" Checked="scope_changed"/>

                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="search_tb" Width="220" Height="24"
                         VerticalContentAlignment="Center"
                         TextChanged="search_changed"/>
                <Button x:Name="clear_search_b" Content="Clear" Width="60" Height="24"
                        Margin="6,0,0,0" Click="clear_search"/>
            </StackPanel>
        </Border>

        <!-- ================= Info line ================= -->
        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="12" Foreground="#555"
                   Margin="0,0,0,6"
                   Text="Pick a new title block type from the dropdown on any row. Nothing is written to the model until you click Apply. Sheets with no title block, or with more than one, are flagged and skipped."/>

        <!-- ================= Sheet grid ================= -->
        <DataGrid Grid.Row="2" x:Name="grid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="All"
                  RowHeight="26" SelectionUnit="FullRow" SelectionMode="Extended"
                  AlternatingRowBackground="#F4F7FB"
                  BorderBrush="#BFBFBF" BorderThickness="1"
                  EnableRowVirtualization="True"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>

                <DataGridTextColumn Header="Sheet Number" Width="130" IsReadOnly="True"
                                    Binding="{Binding Number}"
                                    SortMemberPath="Number"/>

                <DataGridTextColumn Header="Sheet Name" Width="260" IsReadOnly="True"
                                    Binding="{Binding Name}"
                                    SortMemberPath="Name"/>

                <!-- Editable dropdown. ItemsSource is the ONE shared list of type
                     names handed to every row, so no per-row model query. -->
                <DataGridTemplateColumn Header="Title Block" Width="*"
                                        SortMemberPath="TitleBlock">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding TypeNames}"
                                      Text="{Binding TitleBlock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" IsReadOnly="True"
                                      IsEnabled="{Binding CanEdit}"
                                      SelectionChanged="titleblock_changed"
                                      BorderThickness="0" Background="Transparent"
                                      Margin="0" Padding="2,0,0,0"
                                      VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Note" Width="160" IsReadOnly="True"
                                    Binding="{Binding Note}"
                                    SortMemberPath="Note">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#8A4B00"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ================= Status + buttons ================= -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Stretch" Margin="0,10,0,0">
            <TextBlock x:Name="status_tb" Text="" VerticalAlignment="Center"
                       Foreground="#333" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="20,0,0,0">
                <Button x:Name="reset_b"  Content="Reset Changes" Width="120" Height="30"
                        Margin="0,0,10,0" Click="reset_changes"/>
                <Button x:Name="apply_b"  Content="Apply" Width="110" Height="30"
                        IsDefault="True" Click="apply"/>
                <Button x:Name="cancel_b" Content="Cancel" Width="90" Height="30"
                        Margin="8,0,0,0" IsCancel="True" Click="cancel_win"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
