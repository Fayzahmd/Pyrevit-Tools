<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Isolate by Parameter"
        Width="460" Height="600" MinWidth="380" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Categories -->
        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="All" Width="44" Margin="0,0,4,0" Click="select_all_click"/>
                <Button Content="None" Width="44" Click="select_none_click"/>
            </StackPanel>
            <TextBlock Text="1. Categories (in active view)" FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </DockPanel>
        <Border Grid.Row="1" BorderBrush="#FFABADB3" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="category_panel" Margin="6,4"/>
            </ScrollViewer>
        </Border>

        <!-- 2. Parameter -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="2. Parameter (instance or type - type to search)"
                       FontWeight="Bold" Margin="0,0,0,4"/>
            <ComboBox x:Name="param_cb" IsEditable="True" IsTextSearchEnabled="True"/>
        </StackPanel>

        <!-- 3. Condition -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="3. Condition" FontWeight="Bold" Margin="0,0,0,4"/>
            <ComboBox x:Name="operator_cb" SelectionChanged="operator_changed"/>
        </StackPanel>

        <!-- 4. Value -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="4. Value (numbers in project display units)"
                       FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox x:Name="value_tb" Height="24" VerticalContentAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="5" x:Name="status_tb" Margin="0,12,0,0"
                   TextWrapping="Wrap" Foreground="#FF555555"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Isolate" Width="90" Height="26" Margin="0,0,8,0"
                    IsDefault="True" Click="isolate_click"/>
            <Button Content="Cancel" Width="90" Height="26"
                    IsCancel="True" Click="cancel_click"/>
        </StackPanel>
    </Grid>
</Window>
